{
  "version": 1,
  "objects": [
    { "id": "scene_root", "class": "velk-scene.Element" },
    { "id": "camera", "class": "velk-scene.Element" },
    { "id": "column", "class": "velk-scene.Element" },
    { "id": "name", "class": "velk-scene.Element" },
    { "id": "path", "class": "velk-scene.Element" },
    { "id": "status", "class": "velk-scene.Element" }
  ],
  "hierarchies": {
    "scene": { "scene_root": ["camera", "column"], "column": ["name", "path", "status"] }
  },
  "attachments": [
    { "targets": ["camera"], "class": "velk-scene.Camera" },
    { "targets": ["scene_root"], "class": "velk-ui.RectVisual", "properties": { "color": { "r": 0.11, "g": 0.12, "b": 0.14, "a": 1.0 } } },
    { "targets": ["column"], "class": "velk-ui.Stack", "properties": { "axis": 1, "spacing": 12.0 } },
    { "targets": ["column"], "class": "velk-ui.Padding", "properties": { "left": "24px", "top": "24px", "right": "24px", "bottom": "24px" } },
    { "targets": ["name", "path"], "class": "velk-ui.FixedSize", "properties": { "width": "260px", "height": "32px" } },
    { "targets": ["name", "path"], "class": "velk-ui.RectVisual", "properties": { "color": { "r": 0.2, "g": 0.21, "b": 0.24, "a": 1.0 } } },
    { "id": "name_field", "targets": ["name"], "class": "velk-text.TextField", "properties": { "text": "Panel", "font_size": 18.0, "v_align": "center", "color": { "r": 0.92, "g": 0.92, "b": 0.92, "a": 1.0 } } },
    { "id": "path_field", "targets": ["path"], "class": "velk-text.TextField", "properties": { "text": "", "font_size": 18.0, "v_align": "center", "color": { "r": 0.92, "g": 0.92, "b": 0.92, "a": 1.0 } } },
    { "targets": ["status"], "class": "velk-ui.FixedSize", "properties": { "width": "460px", "height": "32px" } },
    { "id": "status_text", "targets": ["status"], "class": "velk-text.TextVisual", "properties": { "text": "Click a field and type. Enter commits, Escape cancels.", "font_size": 16.0, "v_align": "center", "color": { "r": 0.6, "g": 0.62, "b": 0.66, "a": 1.0 } } }
  ]
}
