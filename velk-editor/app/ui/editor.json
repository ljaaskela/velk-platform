  "hierarchies": {
    "scene": {
      "scene_root": ["camera", "root"],
      "root": ["menubar", "body", "statusbar"],
      "menubar": ["menu_file", "menu_edit", "menu_view"],
      "body": ["hierarchy", "viewport", "inspector"],
      "hierarchy": ["hierarchy_title", "hierarchy_body"],
      "hierarchy_title": ["hierarchy_title_label"],
      "hierarchy_body": ["hierarchy_tree"],
      "viewport": ["viewport_title", "viewport_body"],
      "viewport_title": ["viewport_title_label"],
      "viewport_body": ["viewport_label"],
      "inspector": ["inspector_title", "inspector_body"],
      "inspector_title": ["inspector_title_label"],
      "inspector_body": ["inspector_rows"],
      "statusbar": ["status_label"]
    }
  },
  "resources": [
    { "id": "mono", "uri": "font:memory://velk-text/JetBrainsMono-Regular.ttf" }
  ],
  "attachments": [
    { "targets": ["camera"], "class": "velk-scene.Camera" },

    { "targets": ["root"], "class": "velk-ui.Stack", "properties": { "axis": 1, "spacing": 1 } },
    { "targets": ["root"], "class": "velk-ui.RectVisual", "properties": { "color": { "r": 0.05, "g": 0.05, "b": 0.06, "a": 1.0 } } },

    { "targets": ["menubar"], "class": "velk-ui.Stack", "properties": { "axis": 0, "spacing": 0 } },
