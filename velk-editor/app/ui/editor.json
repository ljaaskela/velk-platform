    { "targets": ["menubar"], "class": "velk-ui.Padding", "properties": { "left": "4px" } },
    { "targets": ["menubar"], "class": "velk-ui.RectVisual", "properties": { "color": { "r": 0.14, "g": 0.14, "b": 0.16, "a": 1.0 } } },
    { "targets": ["menu_file", "menu_edit", "menu_view"], "class": "velk-ui.FixedSize", "properties": { "width": "auto" } },
    { "targets": ["menu_file", "menu_edit", "menu_view"], "class": "velk-ui.Padding", "properties": { "left": "10px", "right": "10px" } },
    { "targets": ["menu_file"], "class": "velk-text.TextVisual", "properties": { "text": "File", "font_size": 14.0, "h_align": "center", "v_align": "center", "color": { "r": 0.85, "g": 0.85, "b": 0.88, "a": 1.0 } } },
    { "targets": ["menu_edit"], "class": "velk-text.TextVisual", "properties": { "text": "Edit", "font_size": 14.0, "h_align": "center", "v_align": "center", "color": { "r": 0.85, "g": 0.85, "b": 0.88, "a": 1.0 } } },
