    { "targets": ["inspector"], "class": "velk-ui.FixedSize", "properties": { "width": "300px" } },

    { "targets": ["hierarchy_title", "viewport_title", "inspector_title"], "class": "velk-ui.FixedSize", "properties": { "height": "26px" } },
