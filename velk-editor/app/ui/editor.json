    { "id": "inspector_title_label", "class": "velk-scene.Element" },
    { "id": "inspector_body", "class": "velk-scene.Element" },
    { "id": "inspector_rows", "class": "velk-scene.Element" },

    { "id": "statusbar", "class": "velk-scene.Element" },
    { "id": "status_label", "class": "velk-scene.Element" }
