    { "targets": ["body"], "class": "velk-ui.Stack", "properties": { "axis": 0, "spacing": 1 } },

    { "targets": ["hierarchy", "viewport", "inspector"], "class": "velk-ui.Stack", "properties": { "axis": 1, "spacing": 0 } },
