    { "targets": ["hierarchy_title", "viewport_title", "inspector_title"], "class": "velk-ui.RectVisual", "properties": { "color": { "r": 0.16, "g": 0.16, "b": 0.19, "a": 1.0 } } },
    { "targets": ["hierarchy_title_label"], "class": "velk-text.TextVisual", "properties": { "text": "Hierarchy", "font_size": 13.0, "v_align": "center", "color": { "r": 0.75, "g": 0.75, "b": 0.8, "a": 1.0 } } },
    { "targets": ["viewport_title_label"], "class": "velk-text.TextVisual", "properties": { "text": "Viewport", "font_size": 13.0, "v_align": "center", "color": { "r": 0.75, "g": 0.75, "b": 0.8, "a": 1.0 } } },
    { "targets": ["inspector_title_label"], "class": "velk-text.TextVisual", "properties": { "text": "Inspector", "font_size": 13.0, "v_align": "center", "color": { "r": 0.75, "g": 0.75, "b": 0.8, "a": 1.0 } } },

    { "targets": ["hierarchy_body", "inspector_body"], "class": "velk-ui.RectVisual", "properties": { "color": { "r": 0.11, "g": 0.11, "b": 0.13, "a": 1.0 } } },
    { "targets": ["hierarchy_body"], "class": "velk-ui.ScrollView", "properties": { "color": { "r": 0.55, "g": 0.56, "b": 0.62, "a": 0.8 } } },
    { "targets": ["inspector_body"], "class": "velk-ui.ScrollView", "properties": { "color": { "r": 0.55, "g": 0.56, "b": 0.62, "a": 0.8 } } },
    { "targets": ["hierarchy_tree"], "class": "velk-ui.FixedSize", "properties": { "height": "auto" } },
    { "targets": ["hierarchy_tree"], "class": "velk-ui.TreeView", "properties": { "row_height": 22.0, "color": { "r": 0.22, "g": 0.36, "b": 0.62, "a": 1.0 } } },

    { "targets": ["viewport_body"], "class": "velk-ui.RectVisual", "properties": { "color": { "r": 0.07, "g": 0.07, "b": 0.08, "a": 1.0 } } },
    { "targets": ["viewport_label"], "class": "velk-ui.FixedSize", "properties": { "width": "auto", "height": "auto" } },
    { "targets": ["viewport_label"], "class": "velk-ui.Align", "properties": { "horizontal": "center", "vertical": "center" } },
    { "targets": ["viewport_label"], "class": "velk-text.TextVisual", "properties": { "text": "No application attached", "font_size": 14.0, "color": { "r": 0.45, "g": 0.45, "b": 0.5, "a": 1.0 } } },

    { "targets": ["inspector_rows"], "class": "velk-ui.Stack", "properties": { "axis": 1, "spacing": 0 } },
    { "targets": ["inspector_rows"], "class": "velk-ui.FixedSize", "properties": { "height": "auto" } },
    { "targets": ["inspector_rows"], "class": "velk-ui.Padding", "properties": { "top": "4px", "bottom": "4px" } },

    { "targets": ["statusbar"], "class": "velk-ui.FixedSize", "properties": { "height": "22px" } },
    { "targets": ["statusbar"], "class": "velk-ui.Padding", "properties": { "left": "8px" } },
    { "targets": ["statusbar"], "class": "velk-ui.RectVisual", "properties": { "color": { "r": 0.14, "g": 0.14, "b": 0.16, "a": 1.0 } } },
    { "targets": ["status_label"], "class": "velk-text.TextVisual", "properties": { "text": "Ready", "font_size": 12.0, "v_align": "center", "color": { "r": 0.6, "g": 0.6, "b": 0.65, "a": 1.0 } } }
  ]
}
