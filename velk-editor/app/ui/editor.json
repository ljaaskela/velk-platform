    { "id": "menu_view", "class": "velk-scene.Element" },

    { "id": "body", "class": "velk-scene.Element" },

    { "id": "hierarchy", "class": "velk-scene.Element" },
    { "id": "hierarchy_title", "class": "velk-scene.Element" },
    { "id": "hierarchy_title_label", "class": "velk-scene.Element" },
    { "id": "hierarchy_body", "class": "velk-scene.Element" },
    { "id": "hierarchy_tree", "class": "velk-scene.Element" },

    { "id": "viewport", "class": "velk-scene.Element" },
    { "id": "viewport_title", "class": "velk-scene.Element" },
    { "id": "viewport_title_label", "class": "velk-scene.Element" },
