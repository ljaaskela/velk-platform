{
  "version": 1,
  "objects": [
    { "id": "root", "class": "velk-scene.Element" },
    { "id": "scroll", "class": "velk-scene.Element" },
    { "id": "tree", "class": "velk-scene.Element" }
  ],
  "hierarchies": {
    "scene": { "root": ["scroll"], "scroll": ["tree"] }
  },
  "attachments": [
    { "targets": ["scroll"], "class": "velk-ui.FixedSize", "properties": { "width": "200px", "height": "66px" } },
    { "targets": ["scroll"], "class": "velk-ui.ScrollView" },
    { "targets": ["tree"], "class": "velk-ui.TreeView" }
  ]
}
